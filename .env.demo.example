# Crie a chave em http://localhost:5678 depois do primeiro inicio do n8n.
N8N_API_KEY=
N8N_VERSION=1.105.4

SEARXNG_VERSION=2025.8.8-2b34a3c9e
SEARXNG_SECRET=CHANGE_ME_SEARXNG
