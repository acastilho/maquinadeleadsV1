# Copie para .env.demo usando ./scripts/demo-init.sh.
# Nunca envie .env.demo ao GitHub.

DEMO_PORT=8088

POSTGRES_USER=leads_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
