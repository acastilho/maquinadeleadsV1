+        err.response?.data?.message ||
+        err.response?.data ||
+        err.message ||
+        ''
+      ).toLowerCase();
+
+      const waitingForRegistration =
+        status === 404 && message.includes('not registered');
+
+      if (!waitingForRegistration || attempt === maxAttempts) {
+        throw err;
+      }
+
+      console.log(
+        `Webhook ainda nao registrado; tentativa ${attempt}/${maxAttempts}.`
+      );
+
+      await wait(attempt * 500);
+    }
+  }
+
