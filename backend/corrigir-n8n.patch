+async function triggerWebhook(webhookUrl, maxAttempts = 5) {
+  let lastError;
+
+  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
+    try {
+      return await axios.get(webhookUrl, { timeout: 15000 });
+    } catch (err) {
+      lastError = err;
+
+      const status = err.response?.status;
